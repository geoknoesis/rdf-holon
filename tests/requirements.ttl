@prefix ht: <https://geoknoesis.github.io/rdf-holon/tests/vocab#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://geoknoesis.github.io/rdf-holon/tests/requirements.ttl#COMPLETENESS> a ht:Requirement ;
    rdfs:label "Legacy CompleteHolon provides registration compatibility, not a closed-world claim." ;
    ht:regressionCommand "python tests/test_semantics.py SemanticTests.test_legacy_complete_type_only_registers" ;
    ht:specReference <https://geoknoesis.github.io/rdf-holon/index.html#validation-closure> .

<https://geoknoesis.github.io/rdf-holon/tests/requirements.ttl#CONVERSION> a ht:Requirement ;
    rdfs:label "Content preservation retains M and memberships; assertion preservation also retains all assertions." ;
    ht:regressionCommand "python tests/test_semantics.py SemanticTests.test_content_predicates_do_not_become_declarations_after_conversion",
        "python tests/test_semantics.py SemanticTests.test_dataset_conversion_derives_blank_node_mappings_and_separates_unfiled" ;
    ht:specReference <https://geoknoesis.github.io/rdf-holon/index.html#profile-equivalence> .

<https://geoknoesis.github.io/rdf-holon/tests/requirements.ttl#HARNESS> a ht:Requirement ;
    rdfs:label "Fixture validation is not language conformance; skip and failure outcomes stay distinct." ;
    ht:regressionCommand "python tests/test_runner.py" ;
    ht:specReference <https://geoknoesis.github.io/rdf-holon/tests/README.md> .

<https://geoknoesis.github.io/rdf-holon/tests/requirements.ttl#MEMBERSHIPS> a ht:Requirement ;
    rdfs:label "Memberships refer to registered holons and at least one valid triple term with asserted base." ;
    ht:regressionCommand "python tests/test_semantics.py SemanticTests.test_missing_and_nonterm_reification_rejected" ;
    ht:specReference <https://geoknoesis.github.io/rdf-holon/index.html#validation-procedure> .

<https://geoknoesis.github.io/rdf-holon/tests/requirements.ttl#VALIDATION-SCOPE> a ht:Requirement ;
    rdfs:label "Validation applies only the shapes graphs the holon imports in M, without inheritance, to the requested scope; a missing shapes graph is an error." ;
    ht:specReference <https://geoknoesis.github.io/rdf-holon/index.html#shape-composition> .

<https://geoknoesis.github.io/rdf-holon/tests/rdf-h/manifest.ttl#convert-dataset-to-reifier> ht:covers <https://geoknoesis.github.io/rdf-holon/tests/requirements.ttl#CONVERSION>,
        <https://geoknoesis.github.io/rdf-holon/tests/requirements.ttl#METADATA> .

<https://geoknoesis.github.io/rdf-holon/tests/rdf-h/manifest.ttl#convert-content-not-promoted> ht:covers <https://geoknoesis.github.io/rdf-holon/tests/requirements.ttl#CONVERSION>,
        <https://geoknoesis.github.io/rdf-holon/tests/requirements.ttl#METADATA> .

