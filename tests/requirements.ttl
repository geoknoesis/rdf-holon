<https://geoknoesis.github.io/rdf-holon/tests/requirements.ttl#SPH-SERVICE> a ht:Requirement ;
    rdfs:label "Service-profile protocol conflicts do not silently override scope." ;
    ht:specReference <https://geoknoesis.github.io/rdf-holon/sparql-h/#protocol> .

<https://geoknoesis.github.io/rdf-holon/tests/requirements.ttl#LITERALS> a ht:Requirement ;
    rdfs:label "RDF 1.2 directional literals preserve both language and direction." ;
    ht:regressionCommand "python tests/test_runner.py HarnessTests.test_directional_literal_direction_is_preserved" ;
    ht:specReference <https://geoknoesis.github.io/rdf-holon/turtle-h/#expansion-algorithm> .

<https://geoknoesis.github.io/rdf-holon/tests/requirements.ttl#MODE-VALIDATION> a ht:Requirement ;
    rdfs:label "DIRECT ignores composition errors; aggregate validates full parent relation; visible imports are root-local." ;
    ht:regressionCommand "python tests/test_semantics.py SemanticTests.test_mode_specific_invalid_hierarchy" ;
    ht:specReference <https://geoknoesis.github.io/rdf-holon/index.html#processing-model> .

<https://geoknoesis.github.io/rdf-holon/tests/requirements.ttl#TH-EXPANSION> a ht:Requirement ;
    rdfs:label "Turtle statement expansion is staged before finite RDF-H membership generation." ;
    ht:regressionCommand "python tests/test_semantics.py SemanticTests.test_turtle_generated_triples_are_filed_once" ;
    ht:specReference <https://geoknoesis.github.io/rdf-holon/turtle-h/#expansion-algorithm> .

<https://geoknoesis.github.io/rdf-holon/tests/requirements.ttl#TH-REGISTRATION> a ht:Requirement ;
    rdfs:label "Every block emits unfiled registration into G and M, including empty blocks." ;
    ht:regressionCommand "python tests/test_semantics.py SemanticTests.test_empty_turtle_block_preserves_registration" ;
    ht:specReference <https://geoknoesis.github.io/rdf-holon/turtle-h/#expansion-algorithm> .

<https://geoknoesis.github.io/rdf-holon/tests/requirements.ttl#METADATA> a ht:Requirement ;
    rdfs:label "RDF-H uses one designated M independent of representation." ;
    ht:regressionCommand "python tests/test_semantics.py SemanticTests.test_content_predicates_do_not_become_declarations_after_conversion" ;
    ht:specReference <https://geoknoesis.github.io/rdf-holon/index.html#dataset-resolution> .

<https://geoknoesis.github.io/rdf-holon/tests/requirements.ttl#SPH-SYNTAX> a ht:Requirement ;
    rdfs:label "One holon clause, three modes, standard lexical rules and supported query forms." ;
    ht:regressionCommand "python tests/test_semantics.py SemanticTests.test_parser_preserves_tabs_comments_and_literal_tokens" ;
    ht:specReference <https://geoknoesis.github.io/rdf-holon/sparql-h/#syntax> .

<https://geoknoesis.github.io/rdf-holon/tests/requirements.ttl#REGISTRY> a ht:Requirement ;
    rdfs:label "Registry is explicit K(M); unknown and known empty differ." ;
    ht:regressionCommand "python tests/test_semantics.py SemanticTests.test_unknown_and_registered_empty_are_distinct" ;
    ht:specReference <https://geoknoesis.github.io/rdf-holon/index.html#step-registry> .

<https://geoknoesis.github.io/rdf-holon/tests/requirements.ttl#SPH-ATTRIBUTION> a ht:Requirement ;
    rdfs:label "FROM NAMED HOLONS adds one named graph per selected holon, named by the holon IRI, while the default graph stays the scope union." ;
    ht:specReference <https://geoknoesis.github.io/rdf-holon/sparql-h/#query-dataset> .

