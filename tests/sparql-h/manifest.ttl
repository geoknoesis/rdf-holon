<#named-holons-empty> a ht:SPARQLHEvalTest ;
    mf:name "named-holons-empty" ;
    mf:action [ qt:query <cases/named-holons-empty.srqh> ;
            ht:sourceDataset <cases/empty-holon.trig> ] ;
    mf:result <results/named-holons-empty.srj> .

<#aggregate-rejects-unrelated-cycle> a ht:SPARQLHNegativeEvalTest ;
