@prefix h: <https://w3id.org/rdf-h#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

#################################################################
# Ontology Header
#################################################################

<https://w3id.org/rdf-h#> a owl:Ontology ;
    rdfs:label "RDF-H - A Holonic Modeling Pattern Vocabulary"@en ;
    rdfs:comment "This vocabulary defines the core classes, properties, and SHACL constraint components for representing and validating holarchic structures in RDF."@en ;
    owl:versionIRI <https://w3id.org/rdf-h#0.5> ;
    owl:versionInfo "0.5" ;
    dct:creator [
        a foaf:Person ;
        foaf:name "Stephane Fellah" ;
        foaf:workplaceHomepage <https://geoknoesis.com>
    ] .

#################################################################
# Core Classes
#################################################################

h:Holon a owl:Class, rdfs:Class ;
    rdfs:label "Holon"@en ;
    rdfs:comment "A resource that acts as a context for a set of relationships, representing a 'whole' that is itself composed of parts and may be a part of larger wholes."@en .

#################################################################
# Core Holon Property
#################################################################

# h:inHolon links an RDF 1.2 reifier (an IRI or blank node that
# rdf:reifies a triple term) to the holon that contains the
# reified-triple occurrence. RDF 1.2 places no class restriction on
# reifiers (they are simply IRIs or blank nodes), so h:inHolon
# declares no rdfs:domain. It MUST NOT be confused with the older
# rdf:Statement reification vocabulary, which is independent of the
# RDF 1.2 reifies / triple-term machinery.
h:inHolon a owl:ObjectProperty ;
    rdfs:label "in holon"@en ;
    rdfs:comment "Links the reifier of a triple-occurrence (an IRI or blank node related to a triple term via rdf:reifies, in the sense of RDF 1.2) to the holon that contains the occurrence. The subject is the reifier; the object is the containing holon."@en ;
    rdfs:range h:Holon .

#################################################################
# Part-Of Hierarchy
#################################################################
#
# OWL DL forbids combining owl:TransitiveProperty with
# owl:AsymmetricProperty or owl:IrreflexiveProperty on the same
# property (OWL 2 Direct Semantics, Section 11). RDF-H therefore
# splits the part-whole relation into two top-level properties:
#
#   * h:partOf       — transitive (closes over the hierarchy);
#                      acyclicity is NOT a DL axiom on this
#                      property — it is enforced by the
#                      h:AcyclicPartConstraintComponent SHACL shape.
#
#   * h:directlyPartOf — non-transitive, asymmetric, irreflexive;
#                        DL-safely captures the immediate-part
#                        relation. Sub-property of h:partOf.
#
# The non-transitive sub-properties h:componentOf and h:memberOf
# are sub-properties of h:directlyPartOf and inherit asymmetry /
# irreflexivity by intent (OWL does not propagate property
# characteristics across rdfs:subPropertyOf — they are also
# declared explicitly).
#
# The transitive sub-properties h:substanceOf and h:portionOf
# remain sub-properties of h:partOf; their acyclicity, like that
# of h:partOf itself, is an integrity constraint enforced only
# by SHACL.
#################################################################

# Top-Level Part-Of Properties
h:partOf a owl:ObjectProperty, owl:TransitiveProperty ;
    rdfs:label "part of"@en ;
    rdfs:comment "The top-level transitive super-property for all part-whole relations. Acyclicity is enforced by SHACL (h:AcyclicPartConstraintComponent), not by an OWL axiom, because OWL DL forbids combining TransitiveProperty with IrreflexiveProperty / AsymmetricProperty."@en .

h:hasPart a owl:ObjectProperty, owl:TransitiveProperty ;
    rdfs:label "has part"@en ;
    rdfs:comment "The top-level transitive super-property for all whole-part relations. Inverse of h:partOf."@en ;
    owl:inverseOf h:partOf .

# Direct (Immediate) Part Properties
h:directlyPartOf a owl:ObjectProperty,
        owl:AsymmetricProperty,
        owl:IrreflexiveProperty ;
    rdfs:label "directly part of"@en ;
    rdfs:comment "The non-transitive, asymmetric, irreflexive sub-property of h:partOf for immediate (one-step) part-whole relations. DL-safe complement to the transitive h:partOf."@en ;
    rdfs:subPropertyOf h:partOf .

h:hasDirectPart a owl:ObjectProperty,
        owl:AsymmetricProperty,
        owl:IrreflexiveProperty ;
    rdfs:label "has direct part"@en ;
    rdfs:comment "The inverse of h:directlyPartOf."@en ;
    rdfs:subPropertyOf h:hasPart ;
    owl:inverseOf h:directlyPartOf .

# Sub-Property: Component
h:componentOf a owl:ObjectProperty,
        owl:AsymmetricProperty,
        owl:IrreflexiveProperty ;
    rdfs:label "component of"@en ;
    rdfs:comment "A non-transitive sub-property of h:directlyPartOf for functional or structural parts."@en ;
    rdfs:subPropertyOf h:directlyPartOf .

h:hasComponent a owl:ObjectProperty,
        owl:AsymmetricProperty,
        owl:IrreflexiveProperty ;
    rdfs:label "has component"@en ;
    rdfs:comment "The inverse of h:componentOf."@en ;
    rdfs:subPropertyOf h:hasDirectPart ;
    owl:inverseOf h:componentOf .

# Sub-Property: Member
h:memberOf a owl:ObjectProperty,
        owl:AsymmetricProperty,
        owl:IrreflexiveProperty ;
    rdfs:label "member of"@en ;
    rdfs:comment "A non-transitive sub-property of h:directlyPartOf for elements in a collection or group."@en ;
    rdfs:subPropertyOf h:directlyPartOf .

h:hasMember a owl:ObjectProperty,
        owl:AsymmetricProperty,
        owl:IrreflexiveProperty ;
    rdfs:label "has member"@en ;
    rdfs:comment "The inverse of h:memberOf."@en ;
    rdfs:subPropertyOf h:hasDirectPart ;
    owl:inverseOf h:memberOf .

# Sub-Property: Substance (transitive)
h:substanceOf a owl:ObjectProperty, owl:TransitiveProperty ;
    rdfs:label "substance of"@en ;
    rdfs:comment "A transitive sub-property of h:partOf for material composition. Like h:partOf, its acyclicity is enforced by SHACL rather than an OWL axiom."@en ;
    rdfs:subPropertyOf h:partOf .

h:hasSubstance a owl:ObjectProperty, owl:TransitiveProperty ;
    rdfs:label "has substance"@en ;
    rdfs:comment "The inverse of h:substanceOf."@en ;
    rdfs:subPropertyOf h:hasPart ;
    owl:inverseOf h:substanceOf .

# Sub-Property: Portion (transitive)
h:portionOf a owl:ObjectProperty, owl:TransitiveProperty ;
    rdfs:label "portion of"@en ;
    rdfs:comment "A transitive sub-property of h:partOf for segments of a continuous whole. Like h:partOf, its acyclicity is enforced by SHACL rather than an OWL axiom."@en ;
    rdfs:subPropertyOf h:partOf .

h:hasPortion a owl:ObjectProperty, owl:TransitiveProperty ;
    rdfs:label "has portion"@en ;
    rdfs:comment "The inverse of h:portionOf."@en ;
    rdfs:subPropertyOf h:hasPart ;
    owl:inverseOf h:portionOf .

#################################################################
# SHACL Constraint Components
#################################################################

# Acyclicity validator: checks for cycles via h:partOf OR any of its
# declared sub-properties. The explicit alternation is required because
# SPARQL property paths do not traverse rdfs:subPropertyOf without
# RDFS entailment. If your SHACL engine applies RDFS entailment, the
# simpler form `$this h:partOf+ $this` is equivalent.
h:AcyclicPartConstraintComponent a sh:ConstraintComponent ;
    rdfs:label "Acyclic Part Constraint Component"@en ;
    rdfs:comment "Validates that a holon does not participate in a cycle in the part-of hierarchy."@en ;
    sh:validator h:AcyclicPartValidator .

h:AcyclicPartValidator a sh:SPARQLValidator ;
    sh:message "The focus node participates in a part-of cycle."@en ;
    sh:select """
        PREFIX h: <https://w3id.org/rdf-h#>
        SELECT $this
        WHERE {
            $this (h:partOf|h:directlyPartOf|h:componentOf|h:memberOf|h:substanceOf|h:portionOf)+ $this .
        }
    """ .

# Holon-typing best-practice validator. The h:inHolon range axiom
# already entails ?h rdf:type h:Holon for any object of h:inHolon under
# RDFS entailment, so this validator only fires under engines that do
# NOT apply that entailment. It is therefore a quality / portability
# check rather than a correctness check.
h:HolonIntegrityConstraintComponent a sh:ConstraintComponent ;
    rdfs:label "Holon Integrity Constraint Component"@en ;
    rdfs:comment "Validates that a resource used as a holon is explicitly typed as h:Holon. Under RDFS entailment this constraint is trivially satisfied via the rdfs:range axiom on h:inHolon; under non-inferring SHACL engines it surfaces missing explicit type declarations."@en ;
    sh:validator h:HolonIntegrityValidator .

h:HolonIntegrityValidator a sh:SPARQLValidator ;
    sh:message "The focus node is used as a holon (object of h:inHolon) but is not explicitly typed as h:Holon."@en ;
    sh:select """
        PREFIX h: <https://w3id.org/rdf-h#>
        SELECT $this
        WHERE {
            ?s h:inHolon $this .
            FILTER NOT EXISTS { $this a h:Holon . }
        }
    """ .
